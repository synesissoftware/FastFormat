# Doxyfile for FastFormat (C/C++ API)

PROJECT_NAME           = "FastFormat"
PROJECT_BRIEF          = "The fastest, most robust C++ formatting library"
PROJECT_NUMBER         = 0.7.4

# Prefer SIS_CMAKE_BUILD_DIR-aligned output (same convention as Pantheios /
# xTests / cstring). ./dox/ remains gitignored for legacy/local runs that
# override OUTPUT_DIRECTORY.
OUTPUT_DIRECTORY       = _build/doxygen
CREATE_SUBDIRS         = NO

OPTIMIZE_OUTPUT_FOR_C  = NO
OUTPUT_LANGUAGE        = English
TAB_SIZE               = 4
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = include
TIMESTAMP              = NO

# Public tree is nested (format/, inserters/, sinks/, shims/, util/, …);
# recurse and drop the internal/ tree like Pantheios / CLASP.
INPUT                  = include/fastformat \
                         doc
FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.md
RECURSIVE              = YES
# Keep `internal/` on INPUT so `\file` markers in headers reached via
# `#include` satisfy WARN_AS_ERROR (excluding them caused "not an input
# file" aborts). Omit generated noise only.
EXCLUDE                = include/fastformat/internal/generated
# Resolve `#include <fastformat/...>` under FASTFORMAT_DOCUMENTATION_SKIP_SECTION
# the same way consumers see the tree.
INCLUDE_PATH           = include
SEARCH_INCLUDES        = YES

USE_MDFILE_AS_MAINPAGE = doc/mainpage.md

EXAMPLE_PATH           = examples
EXAMPLE_RECURSIVE      = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html

GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES

MARKDOWN_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
QUIET                  = YES

# Match Pantheios: documentation warnings fail the generator.
WARN_AS_ERROR          = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_DOC_ERROR      = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SKIP_FUNCTION_MACROS   = YES
# Hide implementation / internal noise; skip the real STLSoft umbrella
# include so docs generation need not install STLSoft. Expand stlsoft_ns_qual
# into the stlsoft namespace (see doc/doxygen_stlsoft_stubs.h).
# FASTFORMAT_CALL* strip linkage wrappers from prototypes. Do not predefine
# FASTFORMAT_DECLSPEC / FASTFORMAT_CALLCONV empty — that hides the header
# #define lines and yields "documentation for unknown define".
PREDEFINED             = FASTFORMAT_DOCUMENTATION_SKIP_SECTION \
                         FASTFORMAT_CALL(rt)=rt \
                         FASTFORMAT_EXTERN_C= \
                         STLSOFT_INCL_STLSOFT_H_STLSOFT \
                         stlsoft_ns_qual(x)=::stlsoft::x

HAVE_DOT               = NO


